{
  "name": "tjommie",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @tjommie/ui",
    "desktop": "npm start -w @tjommie/desktop",
    "build": "node scripts/prepare-ui.ts && npm run build -w @tjommie/ui",
    "package": "node --disable-warning=ExperimentalWarning packages/desktop/scripts/package.ts",
    "package:android": "node packages/mobile/scripts/package.ts",
    "lint": "npm run lint -w @tjommie/ui",
    "check:no-any": "node scripts/check-no-any.ts",
    "typecheck": "npm run check:no-any && tsc -p . && npm run typecheck -w @tjommie/ui && npm run typecheck -w @tjommie/transport && npm run typecheck -w @tjommie/mobile && npm run typecheck -w @tjommie/relay",
    "test": "vitest run",
    "test:real": "npm run build && vitest run --mode real",
    "test:packaged": "node --disable-warning=ExperimentalWarning packages/desktop/scripts/verify-packaged.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "rolldown": "^1.2.11",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "vite": "8.3.3",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "http-cache-semantics": "4.3.0"
  }
}
