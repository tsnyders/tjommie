{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["scripts", "packages/protocol/src", "packages/client/src", "packages/desktop/src", "packages/desktop/scripts", "packages/mobile/scripts", "tjommie-rs/tools"]
}
